# 模型服务：任何兼容 OpenAI Chat Completions 的接口都可以
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：界面上可切换的模型列表，逗号分隔（首个为默认）
# LLM_MODELS=deepseek-chat,deepseek-reasoner

# 可选：请求超时（秒）与失败重试次数
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2

# 可选：存档目录，缺省为项目内 data/
# DATA_DIR=
