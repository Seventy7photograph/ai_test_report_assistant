# 模型服务：任何兼容 OpenAI Chat Completions 的接口都可以
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 可选：界面上可切换的模型列表，逗号分隔（首个为默认）
# LLM_MODELS=deepseek-chat,deepseek-reasoner

# 可选：请求超时（秒）与失败重试次数
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2

# 可选：存档目录，缺省为项目内 data/
# DATA_DIR=

# 可选：发版判定阈值（0–1 的比例）。也可以在设置页里改并保存，界面值优先。
# VERDICT_FAIL_RATE=0.05          失败率上限，超过判「有条件通过」
# VERDICT_BLOCKED_RATE=0.05       阻塞率上限，超过判「有条件通过」
# VERDICT_EXECUTION_FLOOR=0.9     执行率下限，低于它结论不覆盖全量
# VERDICT_PASS_LINE=0.95          趋势图的判读线位置
